/*
 * Waveshare 2.8" DSI panel on dsi1 (RK3566), HDMI disabled.
 *
 * The panel's MCU is an I2C device (0x45) wired to dsi1 port@1
 * dsi1 is driven by VP0
 *
 * `panel = <&ws_panel>` on display-subsystem is read by fw_devlink only:
 * it holds the DRM master back until the panel module has bound 0x45.
 */

/dts-v1/;
/plugin/;

/* HDMI off */

&hdmi        { status = "disabled"; };
&hdmi_in_vp0 { status = "disabled"; };
&hdmi_sound  { status = "disabled"; };

/* display pipeline: VOP2 VP0 -> dsi1 -> video_phy1 */

&vop         { status = "okay"; };
&vop_mmu     { status = "okay"; };
&video_phy1  { status = "okay"; };
&dsi1        { status = "okay"; };
&dsi1_in_vp0 { status = "okay"; };
&dsi1_in_vp1 { status = "disabled"; };

&display_subsystem {
	status = "okay";
	panel = <&ws_panel>;	/* fw_devlink probe dependency only */
};

/* The board's DSI-child panel@0 must stay off: this panel lives on I2C. */
&dsi1_panel { status = "disabled"; };

/* dsi1 port@1 -> the I2C panel node below */
&dsi1_out_panel { remote-endpoint = <&ws_panel_in>; };

/* panel MCU and touch, on the DSI connector's I2C bus */
&i2c2 {
	status = "okay";

	ws_panel: panel@45 {
		compatible = "waveshare,2.8inch-panel";
		reg = <0x45>;
		rotation = <90>;

		port {
			ws_panel_in: endpoint {
				remote-endpoint = <&dsi1_out_panel>;
			};
		};
	};

	touchscreen@14 {
		compatible = "goodix,gt911";
		reg = <0x14>;
		touchscreen-size-x = <480>;
		touchscreen-size-y = <640>;
		touchscreen-inverted-y;
		touchscreen-swapped-x-y;
	};
};
